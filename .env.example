# Copy to .env.local (dev) or set in your host's build settings (Cloudflare Pages /
# GitHub Actions). Every value is OPTIONAL: with nothing set, Yapameet works using
# free public MQTT brokers for signaling and public STUN servers.
# NOTE: VITE_* values are baked into the public JS bundle. Never put secrets here.

# ---- Signaling ---------------------------------------------------------------
# "supabase" or "mqtt". Default: supabase if the two Supabase vars are set, else mqtt.
VITE_SIGNALING=

# Supabase Realtime (recommended for real use). Project Settings > API.
# The anon/publishable key is designed to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated MQTT-over-WebSocket brokers (used when signaling=mqtt).
# Default: wss://broker.emqx.io:8084/mqtt,wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_URLS=

# ---- NAT traversal -----------------------------------------------------------
# Comma-separated STUN URLs. Default: Google + Cloudflare public STUN.
VITE_STUN_URLS=

# Option A: static TURN credentials (e.g. Metered Open Relay free tier, 20 GB/month).
# These are visible to anyone who opens the site; a free TURN quota can be used up by others.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Option B: endpoint returning short-lived ICE servers (RTCIceServer[] or { iceServers }).
#  - Cloudflare Pages + functions/api/turn.ts:  /api/turn
#  - Metered:  https://YOURAPP.metered.live/api/v1/turn/credentials?apiKey=YOUR_KEY
VITE_TURN_CREDENTIALS_URL=

# Debug: "true" forces all media through TURN (to verify your TURN setup works).
VITE_FORCE_RELAY=

# ---- Hosting -----------------------------------------------------------------
# Base path when served from a sub-folder, e.g. GitHub Pages project site: /yapameet/
VITE_BASE=/
